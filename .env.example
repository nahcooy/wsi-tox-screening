# Backend
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
OUTPUT_DIR=./outputs
ENABLE_MOCK_MODE=true

# TRIDENT preprocessing / feature extraction
TRIDENT_ROOT=/home/nahcooy/MIL/TRIDENT
TRIDENT_PYTHON=/home/nahcooy/miniconda3/envs/gg/bin/python
DEFAULT_DATASET_CSV=/home/nahcooy/MIL/data_checker/260526/case_control_1000each.csv
DEFAULT_WSI_DIR=/mnt/d/spass_2000
MIL_LAB_ROOT=/home/nahcooy/MIL/MIL_260527/MIL-Lab
MIL_PYTHON=/home/nahcooy/miniconda3/envs/gg/bin/python
DEFAULT_ABMIL_CHECKPOINT=./models/mil/best_grandqc_univ1_abmil_h5_new_label.pth
NULITE_ROOT=/home/nahcooy/NK/NL/NuLite_patch_wise_inference
NULITE_PYTHON=/home/nahcooy/miniconda3/envs/cv/bin/python
DEFAULT_NULITE_H_CHECKPOINT=./models/nulite/NuLite-H-Weights.pth
MATCHED_DATASET_CSV=../tggates_1to1_matched_dataset (2).csv
CELLTYPE_SUMMARY_CSV=../summary_celltype_final_260509.csv

# Optional model roots
ENCODER_MODEL_ROOT=/models/encoders
MIL_MODEL_ROOT=/models/mil
NULITE_MODEL_ROOT=/models/nuclei

# Optional OpenAI API (ver1 legacy — not used by agent in ver2)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_SECONDS=90

# Agent (Qwen2.5-VL via vLLM — ver2)
# vLLM 72B (2x RTX 5090):
#   AGENT_BASE_URL=http://localhost:8080
#   AGENT_MODEL=/home/nahcooy/models/Qwen2.5-VL-72B-Instruct
#   AGENT_API_KEY=token-abc123
# Ollama fallback:
#   AGENT_BASE_URL=http://localhost:11434
#   AGENT_MODEL=qwen2.5vl:7b
#   AGENT_API_KEY=ollama
AGENT_BASE_URL=http://localhost:8080
AGENT_MODEL=/home/nahcooy/models/Qwen2.5-VL-72B-Instruct
AGENT_API_KEY=token-abc123
AGENT_MAX_ITER=15
AGENT_TIMEOUT_SECONDS=900

# RAG backend (feedback store + literature store)
# RAG_BACKEND=json      → keyword search, no deps (default)
# RAG_BACKEND=faiss     → dense vector search  (pip install faiss-cpu sentence-transformers)
# RAG_BACKEND=chroma    → ChromaDB             (pip install chromadb)
RAG_BACKEND=json
RAG_DATA_DIR=./outputs/rag
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ChromaDB remote (only needed when RAG_BACKEND=chroma + remote server)
CHROMA_HOST=
CHROMA_PORT=8001
